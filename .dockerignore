# Only applications/taskfusion currently needs a repo-root build context
# (to reach branding/mv-1.0) — this keeps that context lean rather than
# shipping the whole monorepo into every build.

.git/
**/node_modules/
**/build/
**/dist/
**/coverage/

# other services' build artifacts, irrelevant to any single service's build
**/target/
**/bin/
**/obj/
**/_build/
**/deps/
**/.elixir_ls/

# generated per-app, regenerated by the Dockerfile itself
applications/*/src/assets/brand/

infrastructure/secrets/*.key
infrastructure/secrets/*.crt
infrastructure/secrets/*.pem
