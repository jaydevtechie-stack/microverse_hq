# Microverse Environment

ENVIRONMENT=development

# Gateway
API_GATEWAY_PORT=8080

# Keycloak
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=microverse
KEYCLOAK_CLIENT_ID=
KEYCLOAK_USER=
KEYCLOAK_PASSWORD=

# Taskfusion dashboard (browser-facing, must resolve via the nginx-proxied hostnames)
TASKFUSION_KEYCLOAK_URL=https://sso.microverse.local
TASKFUSION_KEYCLOAK_REALM=microverse
TASKFUSION_KEYCLOAK_CLIENT_ID=mv.app.taskfusion.web

# Active Microverse brand theme — one of: default, vienna, uhuru (see
# branding/mv-1.0/design-system/themes/theme.config.json). Baked into both
# the taskfusion (CRA) and keycloak images at build time — changing it
# requires rebuilding both, not just restarting the containers.
MICROVERSE_BRAND_THEME=default

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=microverse
POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=microverse

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_USER=
MINIO_PASSWORD=

# SpringPix (S3-compatible storage via MinIO; see MINIO_USER/MINIO_PASSWORD above)
AWS_REGION=us-west-2
S3_BUCKET_NAME=springpix

# asset-service — one shared bucket across every service (not SpringPix's
# own private one above); see ROADMAP.md's MinIO proposal
ASSETS_BUCKET_NAME=microverse-assets

# ElixTempo (generate with: mix phx.gen.secret, or `openssl rand -base64 48`)
ELIXTEMPO_SECRET_KEY_BASE=

# RustLedger
RUSTLEDGER_HOURLY_RATE_CENTS=5000
RUSTLEDGER_CURRENCY=USD

# Billing (Stripe test mode — sk_test_.../whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Browser-facing base URL rustledger builds Stripe success/cancel redirect
# URLs from — must resolve via nginx's proxied hostname, not plain localhost.
APP_BASE_URL=https://microverse.local

# AI
OPENAI_API_KEY=

# GoFeeler advanced sentiment engine (Branch 5) — optional override, Go
# service defaults to gpt-4o-mini if unset
GOFEELER_LLM_MODEL=gpt-4o-mini

# Listmonk (self-hosted newsletter — blog's "Get new posts by email" widget)
# Bootstraps the first admin login at https://listmonk.microverse.local
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=
# UUID of the public list new subscribers land in — create the list once
# in the Listmonk admin UI after first boot, then paste its UUID here and
# restart blog-service.
LISTMONK_PUBLIC_LIST_UUID=