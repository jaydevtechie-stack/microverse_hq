{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/analyze": {
            "post": {
                "description": "Returns sentiment (positive, negative, neutral) of given text",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sentiment"
                ],
                "summary": "Analyze sentiment",
                "parameters": [
                    {
                        "description": "Text to analyze",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.SentimentRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.SentimentResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.SentimentRequest": {
            "type": "object",
            "required": [
                "text"
            ],
            "properties": {
                "text": {
                    "type": "string"
                }
            }
        },
        "model.SentimentResponse": {
            "type": "object",
            "properties": {
                "confidence": {
                    "type": "number"
                },
                "sentiment": {
                    "type": "string"
                }
            }
        }
    }
